<Window x:Class="TaskbarGroup.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Group - Ayarlar"
        Height="420"
        Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,10">
            <Button Content="EXE Ekle" Width="100" Margin="0,0,8,0" Click="AddExe_OnClick"/>
            <Button Content="UWP Ekle" Width="100" Margin="0,0,8,0" Click="AddUwp_OnClick"/>
            <Button Content="UWP'leri Tara" Width="100" Margin="0,0,8,0" Click="DiscoverUwp_OnClick"/>
            <Button Content="Yukarı" Width="100" Margin="0,0,8,0" Click="MoveUp_OnClick"/>
            <Button Content="Aşağı" Width="100" Margin="0,0,8,0" Click="MoveDown_OnClick"/>
            <Button Content="Seçileni Sil" Width="100" Click="Remove_OnClick"/>
        </WrapPanel>

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad" Binding="{Binding DisplayName}" Width="1.2*"/>
                <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="0.6*"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                <DataGridTextColumn Header="AUMID" Binding="{Binding AppUserModelId}" Width="1.5*"/>
                <DataGridTextColumn Header="Args" Binding="{Binding Args}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kaydet" Width="100" Margin="0,0,8,0" Click="Save_OnClick"/>
            <Button Content="Kapat" Width="100" Click="Close_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
